# 统一换行符：仓库里一律 LF，检出时按平台转换，避免 Windows/Linux 协作时整文件 diff
* text=auto eol=lf

# 二进制文件别做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.woff binary
*.woff2 binary

# shell / 脚本保持 LF
*.sh text eol=lf
*.mjs text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
