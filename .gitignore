# ---- 密钥与本地数据，绝不入库 ----
.env
.env.local
*.db
*.db-shm
*.db-wal

# ---- 后端 ----
self-hosted/backend/target/
self-hosted/backend/data/
self-hosted/backend/logs/
self-hosted/backend/verify-output/

# ---- 前端 ----
self-hosted/frontend/node_modules/
cloudflare/frontend/node_modules/
self-hosted/frontend/dist/
cloudflare/frontend/dist/
self-hosted/frontend/.vite/
cloudflare/frontend/.vite/

