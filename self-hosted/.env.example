# 复制为 .env 后填写。docker compose 会自动读取同目录下的 .env。
# 这个文件里只有占位符，真实密钥不要提交到 Git（.gitignore 已排除 .env）。

# ============ 数据库 ============
# sqlite（默认，零运维，单文件）或 mysql
PICMAN_DB_MODE=sqlite

# 下面这些只在 PICMAN_DB_MODE=mysql 时生效。
# 迁移已有的 SQLite 数据请看 docs/MYSQL.md，不要直接换库——标签和收藏不会自己过去。
PICMAN_MYSQL_HOST=127.0.0.1
PICMAN_MYSQL_PORT=3306
PICMAN_MYSQL_DB=picman
PICMAN_MYSQL_USER=picman
PICMAN_MYSQL_PASSWORD=换成你自己的强密码
# 只在 docker compose --profile mysql 时用得到，给容器内 MySQL 的 root 账号
PICMAN_MYSQL_ROOT_PASSWORD=再换一个不同的强密码

# ============ 百度网盘开放平台凭证（必填） ============
# 获取位置：https://pan.baidu.com/union/console/applist
#           → 应用列表 → 点开应用 → 应用凭证
BAIDU_DISK_APP_ID=你的AppID
BAIDU_DISK_APP_KEY=你的AppKey
BAIDU_DISK_SECRET_KEY=你的SecretKey

# ============ 选填 ============

# 图库在网盘上的根目录。
# 注意：实测本应用未被限制在 /apps/{应用名} 内，可以填任意目录，但建议保持默认。
BAIDU_BASE_DIR=/apps/picman

# 对外访问端口（浏览器访问 http://<主机>:8088）
PICMAN_HTTP_PORT=8088

# 后端端口，仅用于本机调试直连；生产环境可以不暴露
PICMAN_BACKEND_PORT=8080

# 会话签名密钥。留空则首次启动自动生成并写入数据库。
# 多实例部署或希望重启后固定不变时，显式设置一个长随机串。
# 生成方式：openssl rand -base64 48
PICMAN_JWT_SECRET=

# 登录有效期（小时），默认 7 天
PICMAN_SESSION_HOURS=168

# 用 HTTPS 反代访问时设为 true，让会话 Cookie 带上 Secure 标记
PICMAN_COOKIE_SECURE=false

# 缩略图最长边（像素）
PICMAN_THUMB_SIZE=400

# 上传分片大小。普通用户必须 4MB；会员可调大，但超过档位上限会报 31364
BAIDU_SLICE_SIZE=4194304

# 允许直连的下载主机后缀（逗号分隔），用于防止下载地址被替换成内网地址（SSRF）
PICMAN_DLINK_ALLOWLIST=baidupcs.com,baidu.com,baidubce.com,bdstatic.com,pcs.baidu.com
